\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Appendix A6b -- Culture $\times $ Within-Team Experience Gap, Language Proximity Robustness (cf.\ Table\nobreakspace  {}\ref {tab:t6b}) \relax }}{33}{}\protected@file@percent }
