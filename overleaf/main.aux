\citation{cannonbowers1993,klimoski1994,mathieu2000}
\citation{bekesottaviano2025}
\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Recent work also documents cultural sorting in team interactions. Békés and Ottaviano (2025), for example, show that culturally similar players are more likely to collaborate in professional football. We find a similar pattern in professional doubles tennis, where partnerships are substantially more likely to connect culturally similar players than would be expected under random matching. This naturally raises a second question: once partnerships are formed, does cultural similarity also translate into differences in team performance? We address this question first and subsequently return to partnership formation to examine how cultural sorting operates in our setting.}}{2}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{In project teams, teammates repeatedly exchange information, adjust responsibilities, and anticipate one another's actions. In surgical teams, coordination occurs through repeated communication and rapid adjustment under time pressure. In military teams, shared expectations and communication facilitate coordinated action when explicit communication is costly or constrained. Doubles tennis has the same basic organizational structure at a much smaller scale: two interdependent individuals repeatedly make decisions whose value depends partly on anticipating and adapting to the partner's actions.}}{2}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Tennis Grand Slams are contested across three distinct structural profiles: grass at Wimbledon, clay at the French Open, and hardcourts at the Australian and US Opens. These surfaces fundamentally alter communication dynamics.}}{4}{}\protected@file@percent }
\citation{lazear1999}
\citation{stahl2010,harrisonklein2007}
\citation{wernerfelt2004}
\citation{marschanpiekkari1999,feelyharzing2003}
\citation{melitztoubal2014}
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{A particularly relevant recent contribution is Békés and Ottaviano (2025), who show that cultural homophily remains pervasive in the interaction patterns of highly skilled professional football players, using passing behavior in Europe's top five men's leagues. Their evidence establishes that cultural similarity is associated with whom players interact with within multinational teams, even in settings characterized by high skill, common objectives, and strong incentives to cooperate. We take this pattern of culturally structured interaction as an important starting point and ask a complementary question: does cultural similarity also translate into differences in the ultimate performance of small teams? Rather than examining who interacts with whom within an established team, we study whether culturally similar partnerships are associated with superior team outcomes, and whether such an association persists when the opportunity for coordination to influence performance is sharply constrained.}}{5}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{three}}{5}{}\protected@file@percent }
\citation{cannonbowers1993,klimoski1994,mathieu2000}
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{HERE}}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Data}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Empirical Setting and Sample}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Measuring Cultural Similarity}{7}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Observation Breakdown and Descriptive Statistics\relax }}{8}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:t1}{{1}{8}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Shares of the Three Cultural Similarity Measures, and Unique Teams by Tournament\relax }}{8}{}\protected@file@percent }
\newlabel{tab:t2}{{2}{8}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Theory and Hypotheses}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Cultural Similarity and Team Performance}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Tiebreaks as a Boundary Condition}{9}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Tiebreaks impose a different temporal and competitive environment in which the opportunity for any coordination advantage to accumulate is substantially reduced.}}{10}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{In our sample, no genuine 10-point match tiebreak is ever used to decide the last set at any of the four Grand Slams. Wimbledon is the only tournament with a non-standard deciding-set format: in 15 of our sample's matches (7 in 2018, 3 in 2019, 5 in 2021), the last set was instead resolved through extended advantage-set play with no breaker at all, with final scores as lopsided as 16--14 and 22--20 -- consistent with Wimbledon's pre-2019 rule of no tiebreak in the deciding set and, for the 2019 and 2021 cases, with its subsequent 12-12-breaker rule simply never being triggered because the set ended before reaching 12-12. At the Australian Open, Roland Garros, and US Open -- and in the remaining 79 Wimbledon matches with a completed deciding set -- the last set is instead resolved by the same standard 6--6 seven-point breaker used in every other set.}}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Empirical Analysis}{11}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Match Performance}{11}{}\protected@file@percent }
\newlabel{sec:matchwin}{{4.1}{11}}
\newlabel{matchoutcome}{{1}{11}}
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The ATP does not publish a persistent, tournament-by-tournament doubles ranking at the pair level: the doubles rankings we scrape are strictly individual, one entry per player, with no team or pairing identifier. The only ATP ranking computed at the pair level is the season-only Doubles Race, used exclusively to seed qualification for the year-end ATP Finals; it resets every calendar year and is defined only for pairs that have accumulated enough joint results together that season, so it does not exist for a large share of our sample -- doubles partnerships change frequently across tournaments, and many Grand Slam pairings are new or infrequent. Each player's own individual ranking, by contrast, is continuously available regardless of current partner, so we use the two teammates' average individual ranking as the team-quality measure.}}{11}{}\protected@file@percent }
\newlabel{tab:t3}{{3}{12}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Match Win — Average Marginal Effects (AME) from Logit \relax }}{12}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{As a check on the non-independence of the two team-rows within a match (a win for one team mechanically implies a loss for the other), we re-estimate Table \ref {tab:t3} keeping only one randomly-selected team per match (N=1,864), with robust standard errors and no clustering (since each match now contributes exactly one row). Repeated over 10 random seeds: the same-nationality AME averages 0.0466 (range 0.0161--0.0812, significant at the 5\% level in 5 of 10 draws), same-language averages 0.0517 (range 0.0230--0.0877, significant in 7 of 10 draws), and language proximity averages 0.0471 (range 0.0156--0.0859, significant in 6 of 10 draws) -- consistently the same sign and a broadly similar magnitude to Table \ref {tab:t3}, but genuinely not identical to it draw by draw. Halving the sample inflates standard errors by roughly $\sqrt  {2}$, which is enough to push several individual draws below conventional significance, most visibly for same nationality (already the weakest of the three measures at baseline). We also verified that dropping the model's intercept in favor of full-rank tournament$\times $year fixed effects reproduces Table \ref {tab:t3} exactly (identical AMEs, standard errors, and log-likelihood), confirming the clustered, both-rows specification used throughout the paper -- the standard approach for this kind of paired, mechanically-linked data -- is not manufacturing the result.}}{13}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Disentangling Nationality from Language}{13}{}\protected@file@percent }
\newlabel{sec:natlang}{{4.2}{13}}
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The \textit  {same\_country} and \textit  {same\_language} measures used above are themselves correlated: in our sample, every same-nationality team-obs is also a same-language team-obs (0 team-obs share a nationality but not an official language), so Table\nobreakspace  {}\ref {tab:t3} alone cannot distinguish whether the cultural-similarity association reflects shared nationality specifically -- e.g.\ shared sporting institutions, geographic proximity, or common exposure on the junior circuit -- or a broader communication-related component tied to language. To separate the two, we replace the two indicators with three mutually exclusive categories that partition the full estimation sample: (i) \textit  {same nationality and same language}; (ii) \textit  {different nationality, same language} (e.g.\ Germany/Austria, UK/Australia/US, Spain/Argentina -- teammates who share a language without sharing an institutional or geographic background); and (iii) \textit  {different nationality, different language} (the omitted reference category). Table\nobreakspace  {}\ref {tab:t4} reports the sample sizes, raw win rates, and re-estimated AMEs for these categories using the same controls, fixed effects, and clustering as Table\nobreakspace  {}\ref {tab:t3}.}}{13}{}\protected@file@percent }
\newlabel{tab:t4}{{4}{14}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Match Win: Nationality vs.\ Language Decomposition \relax }}{14}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The key comparison is between the two same-language rows. Same-nationality teams (who are, by construction in this data, also same-language) show a positive and highly significant association with winning (AME = 0.0467, p$<$0.01). Critically, different-nationality teams who share a language show an association of similar magnitude (AME = 0.0438) that is significant at the 10\% level (p = 0.057), despite this being the smallest of the three groups (561 team-obs). Because these teammates share no nationality -- and therefore no shared sporting federation, junior-circuit exposure, or geographic proximity -- this result is inconsistent with the cultural-similarity association being driven solely by nationality-specific institutional factors. It is more consistent with a communication-related component of cultural similarity that operates through shared language independently of shared nationality.}}{15}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Testing Tiebreaks as a Boundary Condition}{15}{}\protected@file@percent }
\newlabel{tab:t5}{{5}{16}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Tiebreak Win — Average Marginal Effects (AME) from Logit \relax }}{16}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{If culturally similar teams were simply stronger for some persistent reason, we would have some reason to expect that advantage to remain visible in tiebreaks.}}{17}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Robustness check: Testing Tennis-Specific Explanations}{17}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Tennis Grand Slams are contested across three distinct structural profiles: grass at Wimbledon, clay at the French Open, and hardcourts at the Australian and US Opens. These surfaces fundamentally alter ball dynamics, where clay generates high friction that slows the ball and increases bounce height, grass minimizes friction to produce low, rapid trajectories, and hardcourts offer a standardized, intermediate speed and bounce. Consequently, these physical variances dictate distinct communication styles. On fast surface like grass, the rapid pace compresses decision-making windows, forcing partners to rely on pre-packaged tactical scripts and implicit, non-verbal cues because there is no time for mid-rally adjustments. Conversely, on slow surface like clay, longer rallies allow for active, asynchronous verbal feedback during the point, as well as more frequent emotional regulation and strategic recalibration between points to sustain high cognitive load.}}{18}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The notes below every table (Tables \ref {tab:t3}--\ref {tab:t8}) have been checked against the underlying estimation code -- controls, fixed effects, clustering, sample sizes, and robustness-spec descriptions all match what was actually estimated.}}{18}{}\protected@file@percent }
\newlabel{tab:t6}{{6}{18}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Stability across playing surfaces \relax }}{18}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Roles of Professional Experience}{19}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Average Professional Experience}{19}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Notice that this is not the years the two players have been working together in the same team, but the average individual professional experience of the two players.}}{19}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{In tennis, partnership can change relatively often. Players may team up with different partners in different tournaments. Calculate how many teams and the share in total have repeated partnership during the sample period and how many unique team appearance.}}{19}{}\protected@file@percent }
\newlabel{tab:t7}{{7}{20}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Team Average Experience \relax }}{20}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Experience Gaps within the Team}{21}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The experience-gap analysis asks whether cultural similarity is particularly valuable when teammates differ in professional experience, conditional on the team's overall competitive strength and average professional experience. That is, among teams with comparable overall strength and comparable average professional experience, does cultural similarity become particularly valuable when the two teammates differ more in professional experience?}}{21}{}\protected@file@percent }
\newlabel{tab:t8}{{8}{22}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Within-Team Experience Gap \relax }}{22}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Team Formation and Cultural Sorting}{23}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Cultural Sorting in Partnership Formation}{24}{}\protected@file@percent }
\newlabel{sec:sorting}{{6.1}{24}}
\newlabel{tab:t9}{{9}{24}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Cultural Sorting in Partnership Formation: Actual vs.\ Random-Matching Benchmark \relax }}{24}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Player Ranking and Cultural Partner Selection}{25}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Because the cultural composition of the player pool differs across tournament-years, a player's probability of having a culturally similar partner may vary mechanically with the set of players entering the event. We therefore extend the specification to also account for the cultural composition of the tournament field: for each focal player, the share of every \emph  {other} player in that tournament-year's full field (every entrant, not only the rank-complete partnerships used above) who shares the focal player's nationality -- and, analogously, the mean pairwise value of \textit  {same\_language}/\textit  {ling\_prox} against every other player in the field -- matched to the corresponding outcome.}}{26}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{We estimate three specifications: (1) own ranking alone (as above); (2) the outcome-matched field-composition variable alone; and (3) own ranking plus field composition. All three specifications exclude the 3 ego-rows whose own nationality is represented by exactly one player in the ego-row sample, so that a single lone-nationality observation cannot by itself drive any coefficient; this leaves $N=4{,}175$ (from 4,178) throughout. We also estimated an own-nationality (country fixed effects) specification in place of own ranking, but do not report it: nationality is a 60-level categorical variable, so it produces 59 separate country-dummy coefficients rather than one interpretable effect, and its logit specifications fail to converge for the two binary outcomes regardless (quasi-complete separation, since several nationalities have as few as 2 ego-rows).}}{26}{}\protected@file@percent }
\newlabel{tab:t10}{{10}{27}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Own Ranking, Tournament-Field Composition, and Partner-Culture Similarity \relax }}{27}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Team Formation Around the Olympic Cycle}{27}{}\protected@file@percent }
\newlabel{tab:t2ab}{{11}{28}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Grand Slam Partnerships Around the Tokyo 2021 and Paris 2024 Olympic Cycles \relax }}{28}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Share of Grand Slam doubles teams sharing a nationality, 2018--2025, spanning both the Tokyo 2021 and Paris 2024 Olympic cycles. Shaded bands mark the pre/preparation/post periods used in Table\nobreakspace  {}\ref {tab:t2ab}; dashed vertical lines mark the Games themselves.\relax }}{29}{}\protected@file@percent }
\newlabel{fig:cycle_nat}{{1}{29}}
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The relatively flat trend around the Tokyo cycle in particular should not be read as evidence about whether players strategically build Grand Slam partnerships in anticipation of the Olympics, because the two populations of teams are largely distinct. Each Olympic doubles draw fields only 32 teams -- 22 nations at Tokyo 2021 and 23 at Paris 2024 -- and cross-referencing these 61 distinct Olympic pairings against every Grand Slam partnership in our 2018--2025 sample shows that only 16 (26\%; 9 of 32 at Tokyo, 10 of 32 at Paris) ever play together at a Grand Slam at all. This is not incidental: Olympic doubles eligibility does not require an existing partnership. A player ranked in the ATP doubles top 10 may enter with any compatriot ranked in the top 300 of either singles or doubles, and additional places are allocated by a combined ranking (each player's best of singles or doubles) that prioritizes pairs already accepted into the singles draw -- the pathway through which, for example, Rafael Nadal and Carlos Alcaraz partnered at the Paris Games despite never having played tour doubles together. Because most Olympic teams are assembled from outside the pool of regular Grand Slam doubles partnerships in the first place, the absence of a shift in Grand Slam partnership formation around the Games is more directly explained by this institutional separation between the two competitive environments than it is informative about the presence or absence of strategic partner-building behavior.}}{30}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Conclusion}{30}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The performance relevance of cultural similarity depends on whether the structure of the task allows communication and coordination advantages to accumulate.}}{31}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Cultural similarity may be more valuable when teams perform tasks requiring repeated interdependent coordination, communication, and adaptation. The value may be less visible when tasks are sufficiently short, tightly constrained, or dominated by small differences in performance. Managers should think about cultural composition jointly with task structure, rather than treating cultural similarity as inherently good or bad.Our evidence suggests that its performance relevance depends on whether team members have sufficient opportunity to communicate, adjust, and coordinate their actions over the course of a task.}}{32}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A}Appendix: Robustness to Age as an Alternative Career-Maturity Proxy}{32}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{\textit  {age\_mean} (team average player age at the tournament) is a second natural proxy for career maturity alongside \textit  {exp\_mean} (years since turning pro); the two are highly correlated (corr = 0.83, implied VIF $\approx $ 3.32 if entered together), so age is estimated in its own separate specification rather than added alongside experience in the main tables.}}{33}{}\protected@file@percent }
\newlabel{tab:ta1}{{A1}{33}}
\@writefile{lot}{\contentsline {table}{\numberline {A1}{\ignorespaces Match Win, \textit  {age\_mean} Replacing \textit  {exp\_mean} \relax }}{33}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {B}Appendix: Heterogeneity by Cultural Individualism (Hofstede IDV)}{33}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{As a further heterogeneity test, we interact each culture measure with the team-average Hofstede individualism score (\textit  {IC\_team\_dm}, demeaned; mean = 62.98, SD = 20.85), testing whether teams from more individualist cultures rely less on in-group cultural bonding, so that the culture-performance association would be smaller for them.}}{33}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {C}Appendix: Robustness to Non-Independence of Team-Rows within a Match}{33}{}\protected@file@percent }
\newlabel{tab:ta2}{{A2}{34}}
\@writefile{lot}{\contentsline {table}{\numberline {A2}{\ignorespaces Match Win, \textit  {age\_mean} and \textit  {exp\_mean} Entered Jointly (Diagnostic) \relax }}{34}{}\protected@file@percent }
\newlabel{tab:ta3}{{A3}{34}}
\@writefile{lot}{\contentsline {table}{\numberline {A3}{\ignorespaces Tiebreak Win, \textit  {age\_mean} Replacing \textit  {exp\_mean} \relax }}{34}{}\protected@file@percent }
