\@writefile{toc}{\contentsline {section}{\numberline {A}Alternative Measures of Linguistic Proximity}{31}{}\protected@file@percent }
\newlabel{app:langprox}{{A}{31}}
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The main text measures linguistic proximity with \textit  {prox1} \citep  {melitztoubal2014}, a continuous $[0,1]$ index built from Ethnologue's language-tree classification (the same measure used by \citet  {bekesottaviano2025}). This Appendix reports every main-text regression table (3, 4, 5, 6, 6b) re-estimated with three alternative constructions of linguistic proximity, one at a time, in place of \textit  {prox1}: (i) the original binary CEPII \textit  {comlang\_ethno} indicator; and two further continuous, independently-constructed robustness measures from \citet  {psw2024}, (ii) an inverted tree-distance index and (iii) a cognate/lexical-based proximity index. All three achieve complete coverage on our sample. Every table below uses the identical sample, controls, and fixed effects as its main-text counterpart.}}{31}{}\protected@file@percent }
\newlabel{tab:a3}{{10}{31}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Appendix A3 -- Match Win, Language Proximity Robustness (cf.\ Table\nobreakspace  {}\ref {tab:t3}) \relax }}{31}{}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Across every table, the binary CEPII measure and the two PSW2024 continuous measures agree qualitatively with the main-text \textit  {prox1} results, with one exception noted in Section\nobreakspace  {}5: the binary measure's culture $\times $ experience interaction (Appendix Table\nobreakspace  {}\ref {tab:a6}, column 1) is statistically significant, while the main-text \textit  {prox1} interaction and both PSW2024 robustness interactions are not.}}{31}{}\protected@file@percent }
\newlabel{tab:a4}{{11}{32}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Appendix A4 -- Tiebreak Win, Language Proximity Robustness (cf.\ Table\nobreakspace  {}\ref {tab:t4}) \relax }}{32}{}\protected@file@percent }
\newlabel{tab:a5}{{12}{32}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Appendix A5 -- Culture $\times $ Surface, Language Proximity Robustness (cf.\ Table\nobreakspace  {}\ref {tab:t5}) \relax }}{32}{}\protected@file@percent }
\newlabel{tab:a6}{{13}{33}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Appendix A6 -- Culture $\times $ Years Since Turning Pro, Language Proximity Robustness (cf.\ Table\nobreakspace  {}\ref {tab:t6}) \relax }}{33}{}\protected@file@percent }
